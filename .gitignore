# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.testsprite/

# Next.js & Build Output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Misc & OS Files
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# Environment Variables & Secrets (CRITICAL for public repo)
.env*
!.env.example

# Local Data, Dumps & Caches
scratch/
.data/
backups/
*.dump
*.sqlite
*.db
*.tar.gz
*.zip

# Data Files & Spreadsheets (prevent competitor/lead data leaks)
*.xlsx
*.xls
*.csv

# Network Traces & Logs
*.har
debug.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Cloud & Task Runners
.vercel
.trigger

# Python & UV Caches
.uv-cache/
.codex-review-uv-cache/

# Playwright Profiles (contains cookies and local browser state)
.playwright_profile*/

# AI Agent Artifacts & Temporary Review Files
/_bmad/
/.agents/
_bmad-output/
.mcp.json
.gemini/
skills-lock.json

# Local Windows Helper Scripts
config.bat
Worker-GUI.bat
Worker-GUI.vbs
scripts/worker-gui.ps1

# Documentation Rules
# Whitelist root public documentation
!README.md
!AGENTS.md
!ARCHITECTURE.md
!CLAUDE.md
!docs/**

# Ignore internal sprint planning drafts and research archives
docs/planning/
docs/archive/
