# ==============================================================================
# Meta Ad Library Tracker — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and populate with your own credentials.
# NEVER commit .env.local or real secrets to a public Git repository.

# ------------------------------------------------------------------------------
# App & Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="your-32-char-random-secret-here"
APP_PASSWORD="your-strong-app-password"
STAFF_PASSWORD="your-strong-staff-password"

# ------------------------------------------------------------------------------
# Supabase & Database (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL Connection String (Transaction Pooler port 6543 or Session port 5432)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase REST / Storage Client Keys
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_KEY="your-supabase-service-role-secret-key"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# ------------------------------------------------------------------------------
# Upstash Redis & QStash (Rate Limiting & Message Queuing)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://[endpoint].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

QSTASH_URL="https://qstash.upstash.io/v2"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="sig_curr_..."
QSTASH_NEXT_SIGNING_KEY="sig_next_..."

# ------------------------------------------------------------------------------
# External Scrapers & Extraction Services
# ------------------------------------------------------------------------------
# Apify (Meta Ad Library Actor)
APIFY_API_TOKEN="apify_api_..."
APIFY_API_TOKENS="token_1,token_2,token_3"
APIFY_ACTOR_ID="curious_coder/facebook-ads-library-scraper"
AUTO_APIFY_DELTA_SCAN="true"

# Firecrawl (Product Landing Page Extraction)
FIRECRAWL_API_KEY="fc-..."

# OpenRouter / OpenAI (AI Classification & Categorization)
OPENROUTER_API_KEY="sk-or-v1-..."

# Image Host & Media Storage (Catbox & Backblaze B2)
CATBOX_USER_HASH=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_ENDPOINT="s3.[region].backblazeb2.com"
B2_REGION="[region]"
B2_DOWNLOAD_URL="https://[bucket-name].s3.[region].backblazeb2.com"

# Cloudflare Image Proxy (optional)
NEXT_PUBLIC_IMAGE_PROXY_URL=""

# Audio Transcription (Instabox / Whisper)
INSTABOX_TRANSCRIPTION_URL=""
INSTABOX_TRANSCRIPTION_KEY=""

# ------------------------------------------------------------------------------
# Trigger.dev (Background Task Engine)
# ------------------------------------------------------------------------------
TRIGGER_SECRET_KEY="tr_prod_..."
TRIGGER_PROJECT_ID="proj_..."

# ------------------------------------------------------------------------------
# Local Playwright Worker Tuning Parameters
# ------------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS="true"
PAGE_TIMEOUT="45000"
RESULT_PATTERN="total_results"
WORKER_DELAY_MIN="3000"
WORKER_DELAY_MAX="7000"
MAX_SCANS_PER_HOUR="120"
MAX_SCANS_PER_DAY="2000"
BATCH_SIZE="10"
BATCH_COOLDOWN_MINUTES="5"
MAX_CONSECUTIVE_FAILURES="5"
BACKOFF_COOLDOWN_MINUTES="15"
AUTO_START_THRESHOLD="1"
AUTO_REFRESH_COOLDOWN_HOURS="12"

# ------------------------------------------------------------------------------
# GitHub Actions Dispatch (Optional)
# ------------------------------------------------------------------------------
GH_PAT_TOKEN=""
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
